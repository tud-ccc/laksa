@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(MLIR)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(GUROBI)
list(REMOVE_ITEM CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Not carried by the targets: the libraries get their include paths from a
# directory-scoped include_directories(), which does not survive export.
set_and_check(LAKSA_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(LAKSA_INCLUDE_DIRS "${LAKSA_INCLUDE_DIR}")

include("${CMAKE_CURRENT_LIST_DIR}/LAKSATargets.cmake")

check_required_components(LAKSA)
