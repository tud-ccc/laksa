      "source": [
        "# Visualize a Graphviz DOT file\n",
        "\n",
        "Set `filename` to the DOT file you want to inspect, then run the code cell below. The graph will be rendered inline in JupyterLab."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import graphviz\n",
        "\n",
        "filename = \"graph.dot\"\n",
        "\n",
        "dot = Path(filename).read_text()\n",
        "graphviz.Source(dot)\n"
      ]
    }
  ],
